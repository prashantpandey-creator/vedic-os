{
  "name": "WeatherDashboard",
  "description": "A simple weather dashboard that displays current weather data for a given location using an API route to fetch real-time weather data.",
  "entities": [
    {
      "id": "weather-dashboard-page",
      "type": "page",
      "route": "/weather",
      "page_type": "dashboard",
      "description": "The main dashboard page that displays current weather data for a location."
    },
    {
      "id": "weather-fetch-api-route",
      "type": "api_route",
      "method": "GET",
      "path": "/api/weather/current",
      "auth_required": false,
      "description": "An API route that fetches current weather data for a given location using a weather API."
    },
    {
      "id": "weather-data-model",
      "type": "data_model",
      "entity": "Weather",
      "fields": [
        {
          "name": "city",
          "type": "string",
          "required": true
        },
        {
          "name": "temperature",
          "type": "number",
          "required": true
        },
        {
          "name": "humidity",
          "type": "number",
          "required": true
        },
        {
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "name": "timestamp",
          "type": "datetime",
          "required": true
        }
      ],
      "description": "Data model representing current weather conditions for a city."
    },
    {
      "id": "weather-temperature-component",
      "type": "component",
      "component_type": "display",
      "props": [
        "temperature",
        "unit"
      ],
      "description": "A component that displays the current temperature in a readable format."
    },
    {
      "id": "weather-humidity-component",
      "type": "component",
      "component_type": "display",
      "props": [
        "humidity"
      ],
      "description": "A component that displays the current humidity level."
    },
    {
      "id": "weather-description-component",
      "type": "component",
      "component_type": "display",
      "props": [
        "description"
      ],
      "description": "A component that displays the weather condition description (e.g., 'Sunny', 'Rainy')."
    },
    {
      "id": "weather-state-store",
      "type": "state_store",
      "store_type": "reactive",
      "description": "A reactive state store that holds the current weather data fetched from the API."
    }
  ],
  "edges": [
    {
      "src": "weather-dashboard-page",
      "rel": "fetches",
      "dst": "weather-fetch-api-route"
    },
    {
      "src": "weather-fetch-api-route",
      "rel": "uses_model",
      "dst": "weather-data-model"
    },
    {
      "src": "weather-dashboard-page",
      "rel": "imports",
      "dst": "weather-temperature-component"
    },
    {
      "src": "weather-dashboard-page",
      "rel": "imports",
      "dst": "weather-humidity-component"
    },
    {
      "src": "weather-dashboard-page",
      "rel": "imports",
      "dst": "weather-description-component"
    },
    {
      "src": "weather-temperature-component",
      "rel": "reads_state",
      "dst": "weather-state-store"
    },
    {
      "src": "weather-humidity-component",
      "rel": "reads_state",
      "dst": "weather-state-store"
    },
    {
      "src": "weather-description-component",
      "rel": "reads_state",
      "dst": "weather-state-store"
    }
  ],
  "auth": {
    "type": "none"
  },
  "pages": 1,
  "components": 3,
  "api_routes": 1,
  "data_models": 1
}